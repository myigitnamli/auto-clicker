<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EE222222"
    android:padding="12dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/tvDrag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="≡ MY Günlük"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:padding="4dp" />

    <EditText
        android:id="@+id/etInterval"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Aralık (ms)"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="#AAAAAA"
        android:text="500" />

    <Button
        android:id="@+id/btnSelectRegion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bölge Seç" />

    <EditText
        android:id="@+id/etKeywords"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Anahtar kelimeler: topla, ödül al, devam"
        android:textColor="@color/white"
        android:textColorHint="#AAAAAA"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bu kelimelerden birini içeren butona rastlarsa otomatik tıklar"
        android:textColor="#999999"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <EditText
        android:id="@+id/etMinMatches"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="En az kaç kelime?"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="#AAAAAA"
        android:text="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ekranda anahtar kelimelerden en az bu kadarı aynı anda görünmeden tıklamaz"
        android:textColor="#999999"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvRegionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:text="Bölge seçilmedi" />

    <Button
        android:id="@+id/btnToggleStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Başlat" />

    <Button
        android:id="@+id/btnClosePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kapat" />

</LinearLayout>
